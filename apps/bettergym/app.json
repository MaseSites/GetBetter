{
  "expo": {
    "name": "BetterGym",
    "slug": "bettergym",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bettergym",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ch.better.bettergym",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ch.better.bettergym",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#B03A31",
          "dark": {
            "backgroundColor": "#B03A31"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Damit du ein Bild auswählen kannst — deine Mahlzeit, eine Nährwerttabelle, oder ein Foto für Hintergrund und Profil.",
          "cameraPermission": "Damit du deine Mahlzeit oder eine Nährwerttabelle fotografieren kannst. Das Bild wird nur für die Analyse verwendet und danach gelöscht.",
          "microphonePermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "BetterGym braucht das Mikrofon nur, wenn du dem Assistenten etwas vorsagst.",
          "speechRecognitionPermission": "BetterGym wandelt Gesprochenes in Text um, wenn du dem Assistenten etwas vorsagst.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Damit du deine Mahlzeit fotografieren und den Strichcode einer Verpackung scannen kannst. Bilder werden nur für die Analyse verwendet und danach gelöscht.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
