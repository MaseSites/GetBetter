# Better Fit — Vorlage. Kopieren nach services/api/.env.local (steht nie im Git)
# und nur dort Werte eintragen. Schlüssel nie in den Chat, nie in den Code.
# Ohne jede Angabe läuft alles im Mock-Modus, ohne einen Aufruf nach aussen.

# --- Bildanalyse (Google Gemini) --------------------------------------------
# mock = Beispielantworten, live = echte Aufrufe (braucht GEMINI_API_KEY)
MEAL_ANALYSIS_MODE=mock
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_CHEAP_MODEL=gemini-3.5-flash-lite
# Springt ein, wenn Google ein Modell als ueberlastet meldet (503); leer = keins
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Preise je Million Tokens in USD (Stand 21.09.2026; 3.8 Flash kostet bis Ende 2026 die Hälfte)
FIT_GEMINI_PRICE_IN=1.50
FIT_GEMINI_PRICE_OUT=7.50
FIT_GEMINI_LITE_PRICE_IN=0.30
FIT_GEMINI_LITE_PRICE_OUT=2.50

# --- Nährwertquellen -----------------------------------------------------------
# USDA FoodData Central (kostenloser Schlüssel, 1000 Anfragen/Stunde)
USDA_FDC_API_KEY=
ENABLE_OPEN_FOOD_FACTS=true
ENABLE_SWISS_FOOD_DATABASE=true
ENABLE_COMMERCIAL_FOOD_PROVIDER=false

# --- Datenschutz und Grenzen -----------------------------------------------------
STORE_ORIGINAL_MEAL_IMAGES=false
MAX_IMAGES_PER_ANALYSIS=2
MAX_MEAL_ANALYSES_PER_USER_PER_DAY=10
# Monatsbudget über alle Konten; ab 80 % Warnung im Admin, ab 100 % keine bezahlte Analyse mehr
MONTHLY_AI_BUDGET_CHF=250
# Kill-Switch: 1 schaltet jede bezahlte KI von Better Fit ab
FIT_AI_DISABLED=0
FIT_RATE_LIMIT_PER_MINUTE=120
BETTER_USD_CHF=0.92

# --- Später, für die Produktion (Supabase) --------------------------------------
# Die Migration mit Row Level Security liegt in supabase/migrations/.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Nur im Backend, nie in der App:
SUPABASE_SERVICE_ROLE_KEY=
